public class FirstRepeating {
    public static void main(String[] args) {
        String str = "abccba";
        for (int i = 0; i < str.length(); i++) {
            for (int j = i + 1; j < str.length(); j++) {
                if (str.charAt(i) == str.charAt(j)) {
                    System.out.println("First Repeating: " + str.charAt(i));
                    return;
                }
            }
        }
    }
}