public class LargestOfThree {
    public static void main(String[] args) {
        int a = 10, b = 45, c = 23;
        int largest = a;
        if (b > largest) {
            largest = b;
        }
        if (c > largest) {
            largest = c;
        }
        System.out.println("Largest number: " + largest);
    }
}